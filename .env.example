# Server-side values only. Never commit a real key.
# For Wrangler/local development, copy these names to ignored .dev.vars.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ACTION_RECEIPT_AI_ENABLED=0
# Set to 1 only on your own loopback development server to permit local AI calls.
ACTION_RECEIPT_ALLOW_LOCAL_AI=0
